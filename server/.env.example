# Server
# On Railway/most hosts, PORT is injected automatically - only set it for local dev.
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS / Socket.io
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
# Leave empty to run fully in-memory (no persistence) during local dev.
MONGODB_URI=mongodb://127.0.0.1:27017/syncstage

# Max upload size for local video/audio files (MB). Default in code is 5120 (5 GB).
MAX_UPLOAD_MB=5120
